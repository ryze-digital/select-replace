{
  "name": "@ryze-digital/select-replace",
  "description": "",
  "license": "MIT",
  "version": "2.0.0",
  "author": " RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "main": "index.js",
  "type": "module",
  "repository": "github:ryze-digital/select-replace",
  "scripts": {
    "lint": "npm-run-all --parallel lint:*",
    "lint:scripts": "prettier src/scripts tests/scripts ./*.js --check && eslint src/scripts tests/scripts ./*.js",
    "lint:styles": "prettier src/styles/** ./*.scss --check && stylelint src/styles/** ./*.scss",
    "lint-fix": "npm-run-all --parallel lint-fix:* --continue-on-error",
    "lint-fix:scripts": "prettier src/scripts tests/scripts ./*.js --write && npm run lint:scripts -- --fix",
    "lint-fix:styles": "prettier src/styles/** ./*.scss --write && npm run lint:styles -- --fix",
    "test": "npm run test:scripts",
    "test:scripts": "jest",
    "test:scripts:coverage": "jest --coverage",
    "build": "npm-run-all --parallel lint:* build:* --continue-on-error",
    "build:scripts": "webpack",
    "build:styles": "npm-run-all sass:build",
    "watch": "npm-run-all --parallel watch:*",
    "watch:scripts": "webpack --watch",
    "watch:styles": "npm-run-all --parallel sass:watch",
    "sass:build": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules",
    "sass:watch": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules --watch"
  },
  "devDependencies": {
    "@ryze-digital/eslint-config-website": "^2.0.0",
    "@ryze-digital/prettier-config-website": "^2.0.0",
    "@ryze-digital/stylelint-config-website": "^2.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "npm-run-all2": "^9.1.0",
    "sass": "^1.108.2",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.113.0",
    "webpack-bundle-analyzer": "^5.4.3",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@ryze-digital/js-utilities": "^1.3.0",
    "@ryze-digital/scss-utilities": "^1.2.0"
  },
  "peerDependencies": {
    "@ryze-digital/js-utilities": "^1.3.0",
    "@ryze-digital/scss-utilities": "^1.2.0"
  },
  "keywords": [
    "select",
    "replace",
    "fake",
    "select2"
  ],
  "engines": {
    "node": ">=24.15",
    "npm": ">=11"
  }
}
